{
  "name": "hart",
  "version": "0.1.0",
  "private": true,
  "description": "Hart 桌游合集：五子棋 / 斗地主 / 一夜狼 / 阿瓦隆",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @hart/server dev\" \"pnpm --filter @hart/client dev\"",
    "dev:server": "pnpm --filter @hart/server dev",
    "dev:client": "pnpm --filter @hart/client dev",
    "build": "pnpm --filter @hart/common build && pnpm --filter @hart/client build && pnpm --filter @hart/server build",
    "start": "pnpm --filter @hart/server start",
    "deploy:build": "pnpm --filter @hart/client build",
    "test": "pnpm --filter @hart/common test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
